PORT=5001
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.2-11b-text-preview
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_FALLBACK_MODEL=meta/llama-3.2-90b-vision-instruct
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-pro-preview
GEMINI_THINKING_LEVEL=low
AI_MAX_OUTPUT_TOKENS=4000
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
PRICE_IN_USD_PER_M=1.50
PRICE_OUT_USD_PER_M=7.50
FALLBACK_PRICE_IN_USD_PER_M=2.00
FALLBACK_PRICE_OUT_USD_PER_M=12.00
USD_INR=97
FLAG_CONFIDENCE=0.8
FLAG_CONFIDENCE_MEASURE=0.9
IMAGE_MAX_EDGE_PX=1568
IMAGE_MAX_BYTES=1000000
RATE_LIMIT_USER=10/minute
RATE_LIMIT_ORG=60/minute
GST_RATE=0.18
RETENTION_MONTHS=12

# Supabase Cloud Database & Auth Settings
APP_ENV=development
DEMO_MODE=1
JWT_SECRET=generate_your_own_secret_key_here
SUPABASE_JWT_SECRET=generate_your_own_secret_key_here
SESSION_SECRET=generate_your_own_secret_key_here

# Database Configuration
DATABASE_PATH=./clinic_records.db

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=../data/private_uploads

# OTP Configuration
OTP_PROVIDER=console

# Quality Thresholds
QUALITY_BLUR_MIN=40.0
QUALITY_DARK_MAX=75.0
QUALITY_GLARE_MAX=12.0

SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
