# Render.com Environment Variables for I2I Medical Records System
# Copy these into your Render dashboard: Settings → Environment
# Replace placeholder values with your actual keys

PORT=5001
AI_PROVIDER=groq
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.2-11b-text-preview

# Supabase Cloud Database - NEW INSTANCE
SUPABASE_URL=https://wiwclaxgwxnblsltdkym.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_KEY_HERE
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET_HERE

# App Configuration
APP_ENV=production
DEMO_MODE=0
JWT_SECRET=YOUR_JWT_SECRET_HERE
SESSION_SECRET=YOUR_SESSION_SECRET_HERE

# Database Configuration (Render uses /tmp for ephemeral storage)
DATABASE_PATH=/tmp/clinic_records.db

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=/tmp/private_uploads

# OTP Configuration (Email only - no Phone OTP)
OTP_PROVIDER=console

# Quality Thresholds
QUALITY_BLUR_MIN=40.0
QUALITY_DARK_MAX=75.0
QUALITY_GLARE_MAX=12.0

# Pricing Configuration
PRICE_IN_USD_PER_M=1.50
PRICE_OUT_USD_PER_M=7.50
FALLBACK_PRICE_IN_USD_PER_M=2.00
FALLBACK_PRICE_OUT_USD_PER_M=12.00
USD_INR=97

# Rate Limiting
RATE_LIMIT_USER=10/minute
RATE_LIMIT_ORG=60/minute
GST_RATE=0.18
RETENTION_MONTHS=12

# AI Configuration
AI_MAX_OUTPUT_TOKENS=4000
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
FLAG_CONFIDENCE=0.8
FLAG_CONFIDENCE_MEASURE=0.9
IMAGE_MAX_EDGE_PX=1568
IMAGE_MAX_BYTES=1000000

# CORS Origins
CORS_ORIGINS=https://ink2insights.onrender.com,https://ink2insights-mobile.onrender.com,http://localhost:3000,http://localhost:5001
